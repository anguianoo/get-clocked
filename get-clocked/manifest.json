{
  "manifest_version": 2,
  "name": "Get Clocked",
  "version": "1.1.2",
  "description": "A draggable, customizable clock on every page: floating, top bar, bottom bar or side bar.",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "defaults.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "96": "icon-96.png"
    },
    "default_title": "Get Clocked settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-clock": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Show or hide the clock"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "defaults.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "clockbar@example.com",
      "strict_min_version": "91.0"
    }
  }
}